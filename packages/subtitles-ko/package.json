  "private": true, "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "INTEGRATION.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-archive-worker.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
