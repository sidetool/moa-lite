# Vercel의 Environment Variables에도 동일하게 등록하세요. docs/DEPLOYMENT.md 참고.
# 실제 값은 커밋하지 않습니다.
APP_URL=http://127.0.0.1:5180
# 32바이트 이상 난수. 배포 업데이트에서는 유지하세요.
APP_SECRET=
# 영문/숫자 4자리씩 4개 그룹: AB12-CD34-EF56-7890 형식.
SETUP_CODE=
# Upstash Redis Free의 REST URL과 REST TOKEN. 서버에서만 사용합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 배포별 구분. 운영 업데이트에서는 유지하세요.
AUTH_NAMESPACE=moa-lite
# Vercel에서 packageManager의 pnpm 버전을 사용하도록 활성화.
ENABLE_EXPERIMENTAL_COREPACK=1
# 선택: 연결 확장이 허용할 앱 origin 목록, 쉼표 구분 (경로/끝 슬래시 없음).
# 비워 두면 APP_URL 또는 Vercel 배포 주소를 빌드 시 사용합니다.
CONNECTOR_READER_ORIGINS=
# 서버의 소스 목록·표지·영상 링크 조회에 내장 ByeDPI 사용 (기본 1, 끄려면 0).
BYEDPI_ENABLED=1
# tlsrec: TLS SNI 레코드 분할. disorder: 패킷 재배열 후 tlsrec 자동 재시도.
BYEDPI_STRATEGY=tlsrec
# 선택: 관리자 진단 메뉴에서 Upstash 실제 할당량 조회. Redis REST 토큰과 다른 관리용 키입니다.
# Upstash 직접 가입 계정의 Account → API Keys에서 발급합니다. VITE_ 접두사를 붙이지 마세요.
UPSTASH_MANAGEMENT_EMAIL=
UPSTASH_MANAGEMENT_API_KEY=
UPSTASH_DATABASE_ID=
# TMDB/Gemini 키는 기존 관리자 설정 화면에서 입력합니다.
# VITE_ 접두사로 비밀값을 등록하지 마세요.
